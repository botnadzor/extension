{
  "cSpell.diagnosticLevel": "Warning",
  "cSpell.userWords": [],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.exclude": {
    ".git": false
  },
  "redhat.telemetry.enabled": false,
  "tailwindCSS.classAttributes": ["class", "className", ".*ClassName"],
  "tailwindCSS.experimental.configFile": {
    "src/entrypoints/content/insertion-styling.css": [
      "src/entrypoints/content/insertions/**"
    ],
    "src/shared/isolated-ui-styling.css": [
      "src/**",
      "!src/entrypoints/content/insertions/**"
    ]
  },
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore", // Handled by ESLint rule better-tailwindcss/enforce-canonical-classes
  "typescript.tsdk": "node_modules/typescript/lib"
}
