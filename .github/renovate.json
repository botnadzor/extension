{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":dependencyDashboardApproval",
    ":disableDigestUpdates",
    ":maintainLockFilesWeekly",
    ":semanticCommitsDisabled"
  ],
  "postUpdateOptions": ["pnpmDedupe"],
  "prConcurrentLimit": 5,
  "rangeStrategy": "pin",
  "timezone": "Etc/UTC",
  "packageRules": [
    {
      "enabled": true,
      "groupName": "eslint",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/eslint/"]
    },
    {
      "autoApprove": true,
      "automerge": true,
      "dependencyDashboardApproval": false,
      "enabled": true,
      "minimumReleaseAge": "2 days",
      "matchPackageNames": ["/^pnpm$/"],
      "schedule": ["after 14:00 on Friday", "before 10:00 on Saturday"]
    },
    {
      "autoApprove": true,
      "automerge": true,
      "dependencyDashboardApproval": false,
      "enabled": true,
      "matchUpdateTypes": ["patch"],
      "matchCurrentValue": "!/^0\\./",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "2 days",
      "schedule": ["after 14:00 on Friday", "before 10:00 on Saturday"]
    },
    {
      "autoApprove": true,
      "automerge": true,
      "dependencyDashboardApproval": false,
      "enabled": true,
      "matchDepTypes": ["devDependencies"],
      "matchManagers": ["npm"],
      "minimumReleaseAge": "2 days",
      "schedule": ["after 14:00 on Friday", "before 10:00 on Saturday"]
    },
    {
      "autoApprove": true,
      "automerge": true,
      "dependencyDashboardApproval": false,
      "enabled": true,
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^lucide-/"],
      "minimumReleaseAge": "2 days",
      "schedule": ["after 14:00 on Friday", "before 10:00 on Saturday"]
    }
  ]
}
