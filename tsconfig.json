{
  "extends": [
    "@tsconfig/node24",
    "@tsconfig/strictest",
    "@tsconfig/node-ts",
    "./.wxt/tsconfig.json"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    // https://github.com/microsoft/TypeScript/issues/26238
    "noErrorTruncation": true,

    // Handled by ESLint
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
