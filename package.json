{
  "name": "@botnadzor/extension",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm-run-all2 --continue-on-error \"build:*\"",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox --mv3",
    "dev": "echo \"Run 'pnpm dev:chrome' or 'pnpm dev:firefox' instead\"",
    "dev:chrome": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "fix": "npm-run-all2 --continue-on-error \"fix:*\"",
    "fix:eslint": "wxt prepare && eslint --max-warnings=0 --fix",
    "fix:knip": "wxt prepare && knip --fix --allow-remove-files",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --cache --write .",
    "lint": "npm-run-all2 --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --no-progress --dot \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "wxt prepare && knip",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --cache --check .",
    "lint:tsc": "wxt prepare && tsc --noEmit",
    "prepare": "husky && wxt prepare",
    "test": "echo \"Run 'pnpm test:system' or 'pnpm test:unit' instead\"",
    "test:system": "echo \"system tests are not configured yet\"",
    "test:unit": "vitest run",
    "zip": "npm-run-all2 --continue-on-error \"zip:*\"",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox --mv3"
  },
  "lint-staged": {
    "**": [
      "prettier --write"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson",
      "prettier-plugin-sh"
    ],
    "overrides": [
      {
        "files": "src/shared/@model/root-config/seed.json",
        "options": {
          "parser": "json-stringify"
        }
      }
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
    "@logtape/logtape": "2.0.4",
    "@orpc/client": "1.13.6",
    "@orpc/contract": "1.13.6",
    "@webext-core/proxy-service": "2.0.0",
    "class-variance-authority": "0.7.1",
    "dexie": "4.3.0",
    "es-toolkit": "1.45.1",
    "immer": "11.1.4",
    "intl-messageformat": "11.1.2",
    "jsonrepair": "3.13.3",
    "lru-cache": "11.2.7",
    "lucide-react": "0.577.0",
    "lucide-static": "0.577.0",
    "marked-react": "3.0.2",
    "nanoid": "5.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "semver": "7.7.4",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "2.3.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint-react/eslint-plugin": "2.13.0",
    "@eslint/js": "9.39.4",
    "@orpc/openapi": "1.13.6",
    "@orpc/openapi-client": "1.13.6",
    "@orpc/zod": "1.13.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.2.1",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@wxt-dev/auto-icons": "1.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "9.7.0",
    "eslint": "9.39.4",
    "eslint-plugin-better-tailwindcss": "4.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "63.0.0",
    "husky": "9.1.7",
    "knip": "5.86.0",
    "lint-staged": "16.3.3",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.4.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.0.18",
    "wxt": "0.20.18",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@10.32.1"
}
