{
  "name": "@botnadzor/extension",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm-run-all2 --continue-on-error \"build:*\"",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox --mv3",
    "dev:chrome": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "fix": "npm-run-all2 --continue-on-error \"fix:*\"",
    "fix:eslint": "wxt prepare && eslint --max-warnings=0 --fix",
    "fix:knip": "wxt prepare && knip --fix --allow-remove-files",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --cache --write .",
    "lint": "npm-run-all2 --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --no-progress --dot \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "wxt prepare && knip",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --cache --check .",
    "lint:tsc": "wxt prepare && tsc --noEmit",
    "prepare": "husky && wxt prepare",
    "test:system": "echo \"system tests are not configured yet\"",
    "test:unit": "echo \"unit tests are not configured yet\"",
    "zip": "npm-run-all2 --continue-on-error \"zip:*\"",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox --mv3"
  },
  "lint-staged": {
    "**": [
      "prettier --write"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson",
      "prettier-plugin-sh"
    ]
  },
  "dependencies": {
    "@logtape/logtape": "2.0.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@webext-core/job-scheduler": "1.0.0",
    "@webext-core/proxy-service": "2.0.0",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "dexie": "4.2.1",
    "es-toolkit": "1.44.0",
    "immer": "11.1.3",
    "intl-messageformat": "11.1.1",
    "lru-cache": "11.2.4",
    "lucide-react": "0.562.0",
    "lucide-static": "0.562.0",
    "marked-react": "3.0.2",
    "nanoid": "5.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "semver": "7.7.3",
    "tailwind-merge": "3.4.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "2.3.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.6.0",
    "@eslint-react/eslint-plugin": "2.7.2",
    "@eslint/js": "9.39.2",
    "@stylistic/eslint-plugin": "5.7.0",
    "@tailwindcss/vite": "4.1.18",
    "@tsconfig/node-ts": "23.6.2",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.1.2",
    "@wxt-dev/auto-icons": "1.1.0",
    "@wxt-dev/module-react": "1.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "9.6.0",
    "eslint": "9.39.2",
    "eslint-plugin-better-tailwindcss": "4.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-regexp": "3.0.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "husky": "9.1.7",
    "knip": "5.82.1",
    "lint-staged": "16.2.7",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.0",
    "prettier-plugin-sh": "0.18.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "wxt": "0.20.13"
  },
  "packageManager": "pnpm@10.28.1"
}
