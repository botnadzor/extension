{
  "name": "@botnadzor/extension",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm-run-all2 --continue-on-error \"build:*\"",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox --mv3",
    "dev": "echo \"Run 'pnpm dev:chrome' or 'pnpm dev:firefox' instead\"",
    "dev:chrome": "wxt --browser chrome",
    "dev:firefox": "wxt --browser firefox",
    "fix": "npm-run-all2 --continue-on-error \"fix:*\"",
    "fix:eslint": "wxt prepare && eslint --max-warnings=0 --fix",
    "fix:knip": "wxt prepare && knip --fix --allow-remove-files",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --cache --write .",
    "lint": "npm-run-all2 --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --no-progress --dot \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "wxt prepare && knip",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --cache --check .",
    "lint:tsc": "wxt prepare && tsc --noEmit",
    "prepare": "husky && wxt prepare",
    "test": "echo \"Run 'pnpm test:system' or 'pnpm test:unit' instead\"",
    "test:system": "echo \"system tests are not configured yet\"",
    "test:unit": "vitest run",
    "zip": "npm-run-all2 --continue-on-error \"zip:*\"",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:firefox": "wxt zip --browser firefox --mv3"
  },
  "lint-staged": {
    "**": [
      "prettier --write"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson",
      "prettier-plugin-sh"
    ],
    "overrides": [
      {
        "files": "src/shared/@model/root-config/seed.json",
        "options": {
          "parser": "json-stringify"
        }
      }
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@logtape/logtape": "2.3.3",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@tailwindcss/typography": "0.5.20",
    "@visx/axis": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@webext-core/proxy-service": "3.0.2",
    "class-variance-authority": "0.7.1",
    "dexie": "4.4.5",
    "es-toolkit": "1.52.0",
    "immer": "11.1.18",
    "intl-messageformat": "11.2.14",
    "jsonrepair": "3.15.0",
    "lru-cache": "11.5.2",
    "lucide-react": "1.42.0",
    "lucide-static": "1.42.0",
    "marked-react": "4.0.0",
    "nanoid": "6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "2.3.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.0",
    "@eslint-react/eslint-plugin": "5.19.0",
    "@eslint/js": "9.39.5",
    "@orpc/openapi": "1.15.0",
    "@orpc/openapi-client": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "10.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "64.0.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "17.5.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.8.4",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "5.0.0",
    "wxt": "0.21.4",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@12.3.4"
}
